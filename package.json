{
  "name": "pdf-spreadsheet-sorter",
  "version": "1.0.0",
  "private": true,
  "description": "書類PDFを読み取り、顧問先・書類種別・期間ごとに仕分けて一覧表に整理する(ローカルAI版・Google版・デモ)",
  "scripts": {
    "build": "node scripts/build.js",
    "samples": "python3 scripts/generate_samples.py",
    "test": "node scripts/build.js && node --test test/*.test.js",
    "local": "node local/sorter.js",
    "local:app": "node local/server.js --config local/config.json",
    "evaluate": "node local/evaluate.js"
  },
  "dependencies": {
    "pdfjs-dist": "3.11.174"
  }
}
